rules_version = '2';

// Regras do Firebase Storage para o Flag Platform.
//
// O admin_web faz upload de imagens (person/team/venue photos) e download
// para visualização no navegador. Usuários autenticados podem ler/escrever.
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Uploads de imagem de entidades =====
    match /persons/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /teams/{document=**}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /venues/{document=**}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ===== Demais objetos (padrão) =====
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}