rules_version = '2';

// Regras do Firebase Storage para o Flag Platform.
//
// Os uploads de imagens serão feitos pelo backend Java via Firebase Admin
// SDK (issues H14), que ignora estas regras. O cliente web apenas lê
// (download de imagens para exibição no navegador).
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Leitura pública =====
    // Imagens são públicas (exibidas no app web sem autenticação).
    allow read: if true;

    // ===== Escrita negada ao cliente =====
    // O cliente web não envia arquivos direto ao Storage; uploads são feitos
    // pelo backend Java (Admin SDK), que ignora estas regras.
    allow write: if false;
  }
}