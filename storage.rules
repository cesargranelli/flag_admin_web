rules_version = '2';

// Regras do Firebase Storage para o Flag Platform.
//
// Os uploads de imagens serão feitos pelo backend Java via Firebase Admin
// SDK (issues H14), que ignora estas regras. O cliente web apenas lê
// (download de imagens para exibição no navegador).
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Uploads e Leitura de Logos de Organizações =====
    // Imagens são públicas para exibição no frontend web.
    // Usuários autenticados no Admin Web podem enviar logos de até 5MB.
    match /organizations/logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ===== Uploads e Leitura de Logos de Agremiações (Instituições) =====
    match /institutions/logos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Demais caminhos: leitura pública liberada para assets/mídias; escrita negada ao cliente (Admin SDK)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}