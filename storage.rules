rules_version = '2';

// Regras do Firebase Storage para o Flag Platform.
//
// Os uploads de imagens serão feitos pelo backend Java via Firebase Admin
// SDK (issues H14), que ignora estas regras. O cliente web apenas lê
// (download de imagens para exibição no navegador).
service firebase.storage {
  match /b/{bucket}/o {

    // ===== Leitura pública =====
    // Imagens são públicas (exibidas no app web sem autenticação).
    allow read: if true;

    // ===== Uploads de Logos de Organizações =====
    // Usuários autenticados no Admin Web podem enviar logos de até 5MB
    match /organizations/logos/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Demais caminhos: escrita negada ao cliente (feita via Admin SDK)
    match /{allPaths=**} {
      allow write: if false;
    }
  }
}