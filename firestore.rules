rules_version = '2';

// Regras do Firestore para o Flag Platform.
//
// O acesso é restrito a usuários autenticados no Firebase Auth.
// O backend (Firebase Admin SDK) ignora estas regras (privilegiado).
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Coleções administradas pelo org (CRUD via admin_web) =====
    match /organizations/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /persons/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /teams/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /venues/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /seasons/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /competitions/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /games/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /rounds/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /rosters/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ===== Demais coleções (padrão) =====
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}